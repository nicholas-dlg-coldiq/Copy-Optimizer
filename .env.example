# ==============================================
# COLDIQ EMAIL OPTIMIZER - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your actual values

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================

# Environment mode (development or production)
NODE_ENV=development

# Server port
PORT=3000

# Server host (default: 0.0.0.0 for cloud platforms)
HOST=0.0.0.0

# ==============================================
# AI PROVIDER CONFIGURATION
# ==============================================

# AI provider to use: 'anthropic' or 'openrouter'
# - anthropic: Use Anthropic Claude API directly (may be faster than OpenRouter)
# - openrouter: Use OpenRouter to access multiple LLM providers
#
# PERFORMANCE TIP: If using Sonnet models, test both direct Anthropic and OpenRouter
# to see which is faster. OpenRouter adds routing overhead but provides access to more models.
AI_PROVIDER=openrouter

# Prompt mode: 'lite' or 'full'
# - lite: Faster responses (~50% smaller prompt, ~12-15s response time)
# - full: Comprehensive analysis (larger prompt, ~20-25s response time)
PROMPT_MODE=lite

# Anthropic API Key (required if AI_PROVIDER=anthropic)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenRouter API Key (required if AI_PROVIDER=openrouter)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenRouter Model (used when SHOW_ADMIN_PANEL=false)
# When admin panel is hidden, this model is used instead of user selection
#
# RECOMMENDED FAST MODELS (tested for speed + quality):
# - google/gemini-2.5-flash               (Latest Gemini Flash model)
# - google/gemini-2.0-flash-thinking-exp  (6-10s, $0.75/1k req) ⭐ RECOMMENDED
# - openai/gpt-4o                         (8-12s, $2.50/1k req)
# - anthropic/claude-haiku-4.5            (10-15s, $1.40/1k req)
# - anthropic/claude-3-5-sonnet           (20-25s, $3-5/1k req) - Good baseline
# - anthropic/claude-sonnet-4-5:beta      (May be slow via OpenRouter)
#
# For best results: Test Gemini Flash Thinking first, then GPT-4o if needed
OPENROUTER_MODEL=anthropic/claude-3-5-sonnet

# ==============================================
# DATABASE CONFIGURATION (SUPABASE)
# ==============================================

# Supabase Project URL
# Get from: Supabase Dashboard → Settings → API → Project URL
# Example: https://xxxxxxxxxxxxx.supabase.co
SUPABASE_URL=your-supabase-project-url

# Supabase Service Role Key (SECRET - for server-side only)
# Get from: Supabase Dashboard → Settings → API → Service Role Key
# WARNING: Keep this secret! Do not commit to version control or expose to frontend
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ==============================================
# LOGGING CONFIGURATION
# ==============================================

# Enable file logging (true/false)
# When true, creates detailed log files in ./logs directory
ENABLE_FILE_LOGGING=true

# Enable console logs (true/false)
# When true, outputs logs to console/terminal
ENABLE_CONSOLE_LOGS=true

# Log detailed prompts and responses (true/false)
# When true, saves full prompt/response content to log files
# WARNING: This can create large log files. Set to false in production unless debugging.
LOG_DETAILED_PROMPTS=true

# ==============================================
# ADMIN/SETTINGS PANEL
# ==============================================

# Show admin settings panel (true/false)
# When false, hides the settings cog button in the UI
# Use false for production deployments where you don't want users changing settings
SHOW_ADMIN_PANEL=true

# ==============================================
# SECURITY CONFIGURATION
# ==============================================

# Allowed origins for CORS (comma-separated list)
# In production, specify your domain(s) for security
# Example: https://yourdomain.com,https://www.yourdomain.com
# Leave empty or omit for development (allows all origins)
ALLOWED_ORIGINS=
